{
  "functions": [
    {
      "source": "functions-reports",
      "codebase": "reports",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "test",
        "lib/*.map",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run verify:deploy"
      ]
    }
  ]
}
