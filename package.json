{
  "name": "life-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"try{require('fs').closeSync(require('fs').openSync('out/.nojekyll','a'))}catch{}\"",
    "build:static": "node scripts/build-static-export.mjs",
    "build:desktop": "node scripts/build-desktop-export.mjs",
    "build:desktop:staging": "node scripts/run-staging-desktop.mjs export",
    "tauri:dev:staging": "node scripts/run-tauri.mjs dev staging",
    "tauri:build:staging": "node scripts/run-staging-desktop.mjs tauri-build",
    "tauri:build:staging:resolved-config": "node scripts/run-tauri.mjs build staging",
    "tauri:build:production": "node scripts/run-tauri.mjs build production",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/refresh-next-types.mjs && next typegen && tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project life-tracker-test \"vitest run --config vitest.rules.config.ts\"",
    "test:functions:emulator": "firebase emulators:exec --only firestore --project life-tracker-test \"npm --prefix functions test -- --run test/domain/firestore-repository.emulator.test.ts\"",
    "test:auth:emulator": "firebase emulators:exec --only auth --project life-tracker-test \"npm --prefix functions test -- --run test/http/auth.emulator.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:emulator": "node e2e/prepare-emulator-config.mjs && npm --prefix functions run build && CI=1 FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 FUNCTIONS_DISCOVERY_TIMEOUT=120 E2E_USE_FUNCTIONS_EMULATOR=true firebase emulators:exec --only auth,firestore,functions --project life-tracker-test \"npm run test:e2e\"",
    "pretest:e2e:static": "npm run build:static",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "pretest:e2e:staging": "npm --prefix functions run build",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:desktop:config": "node --test scripts/desktop-build-profile.test.mjs scripts/run-staging-desktop.test.mjs scripts/run-tauri.test.mjs",
    "check:static-security": "node scripts/check-static-security.mjs",
    "check:desktop-security": "node scripts/check-desktop-security.mjs",
    "firebase:deploy": "npm run build && firebase deploy --project life-tracker-staging",
    "firebase:rules": "firebase deploy --project life-tracker-staging --only firestore:rules"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@life-tracker/ai-contract": "file:packages/ai-contract",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tiptap/extension-color": "^3.15.0",
    "@tiptap/extension-font-family": "^3.15.0",
    "@tiptap/extension-highlight": "^3.15.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-text-align": "^3.15.0",
    "@tiptap/extension-text-style": "^3.15.0",
    "@tiptap/extension-underline": "^3.15.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "firebase": "12.17.1",
    "lucide-react": "^0.294.0",
    "next": "15.5.23",
    "react": "18",
    "react-dom": "18",
    "recharts": "^2.8.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.58.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "3.2.7",
    "autoprefixer": "^10.0.1",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "firebase-tools": "^15.27.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
