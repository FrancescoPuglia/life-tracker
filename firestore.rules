rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function ownsPath(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // New client-created documents must carry the authenticated owner. `uid`
    // is optional because the established data model uses `userId`, but if a
    // document has both fields they must agree with the authenticated path.
    function hasValidCreateOwnership(uid, documentId) {
      return request.resource.data.userId == uid
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('id' in request.resource.data) || request.resource.data.id == documentId)
        && !request.resource.data.keys().hasAny([
          'ownerId',
          'ownerUid',
          'actorUid',
          '_version',
          '_aiPlanId',
          '_aiVersion',
          'serverVersion'
        ]);
    }

    // Historical documents may not have an embedded owner. Their location is
    // still user-scoped, so the owner path protects them while allowing normal
    // reads and non-ownership updates. Documents with an owner must agree with
    // that path.
    function existingOwnershipMatchesPath(uid) {
      return (!('userId' in resource.data) || resource.data.userId == uid)
        && (!('uid' in resource.data) || resource.data.uid == uid)
        && (!('ownerId' in resource.data) || resource.data.ownerId == uid)
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == uid);
    }

    function keepsProtectedFieldsImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'userId',
          'uid',
          'ownerId',
          'ownerUid',
          'actorUid',
          'id',
          'createdAt',
          '_version',
          '_aiPlanId',
          '_aiVersion',
          'serverVersion'
        ]);
    }

    function hasValidTimeBlockFields(collectionName) {
      return collectionName != 'timeBlocks'
        || (
          request.resource.data.startTime is timestamp
          && request.resource.data.endTime is timestamp
          && request.resource.data.startTime < request.resource.data.endTime
          && request.resource.data.status in [
            'planned',
            'in_progress',
            'completed',
            'cancelled',
            'overrun'
          ]
          && request.resource.data.type in [
            'work',
            'break',
            'buffer',
            'travel',
            'meeting',
            'focus',
            'admin',
            'deep',
            'shallow'
          ]
        );
    }

    // These values drive scheduling, progress, and streak calculations. They
    // remain optional for old documents, but malformed or negative values may
    // not be introduced or preserved by a client write.
    function hasValidCriticalNumbers() {
      return (!('estimatedMinutes' in request.resource.data)
          || (request.resource.data.estimatedMinutes is number
            && request.resource.data.estimatedMinutes >= 0))
        && (!('estimatedDuration' in request.resource.data)
          || (request.resource.data.estimatedDuration is number
            && request.resource.data.estimatedDuration >= 0))
        && (!('actualMinutes' in request.resource.data)
          || (request.resource.data.actualMinutes is number
            && request.resource.data.actualMinutes >= 0))
        && (!('actualHours' in request.resource.data)
          || (request.resource.data.actualHours is number
            && request.resource.data.actualHours >= 0))
        && (!('duration' in request.resource.data)
          || (request.resource.data.duration is number
            && request.resource.data.duration >= 0))
        && (!('targetHours' in request.resource.data)
          || (request.resource.data.targetHours is number
            && request.resource.data.targetHours >= 0))
        && (!('timeAllocationTarget' in request.resource.data)
          || (request.resource.data.timeAllocationTarget is number
            && request.resource.data.timeAllocationTarget >= 0))
        && (!('weeklyHoursTarget' in request.resource.data)
          || (request.resource.data.weeklyHoursTarget is number
            && request.resource.data.weeklyHoursTarget >= 0))
        && (!('totalHoursTarget' in request.resource.data)
          || (request.resource.data.totalHoursTarget is number
            && request.resource.data.totalHoursTarget >= 0))
        && (!('targetValue' in request.resource.data)
          || (request.resource.data.targetValue is number
            && request.resource.data.targetValue >= 0))
        && (!('currentValue' in request.resource.data)
          || (request.resource.data.currentValue is number
            && request.resource.data.currentValue >= 0))
        && (!('progress' in request.resource.data)
          || (request.resource.data.progress is number
            && request.resource.data.progress >= 0))
        && (!('streakCount' in request.resource.data)
          || (request.resource.data.streakCount is number
            && request.resource.data.streakCount >= 0))
        && (!('bestStreak' in request.resource.data)
          || (request.resource.data.bestStreak is number
            && request.resource.data.bestStreak >= 0))
        && (!('currentStreak' in request.resource.data)
          || (request.resource.data.currentStreak is number
            && request.resource.data.currentStreak >= 0))
        && (!('maxStreak' in request.resource.data)
          || (request.resource.data.maxStreak is number
            && request.resource.data.maxStreak >= 0))
        && (!('totalLogins' in request.resource.data)
          || (request.resource.data.totalLogins is number
            && request.resource.data.totalLogins >= 0));
    }

    function validClock(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validReminderOffset(value) {
      return value is int && value >= 1 && value <= 1440;
    }

    function validReminderOffsets(offsets) {
      return offsets is list
        && offsets.size() >= 1
        && offsets.size() <= 8
        && validReminderOffset(offsets[0])
        && (offsets.size() < 2 || validReminderOffset(offsets[1]))
        && (offsets.size() < 3 || validReminderOffset(offsets[2]))
        && (offsets.size() < 4 || validReminderOffset(offsets[3]))
        && (offsets.size() < 5 || validReminderOffset(offsets[4]))
        && (offsets.size() < 6 || validReminderOffset(offsets[5]))
        && (offsets.size() < 7 || validReminderOffset(offsets[6]))
        && (offsets.size() < 8 || validReminderOffset(offsets[7]));
    }

    function hasValidNotificationPreferences(uid, documentId) {
      let data = request.resource.data;
      return documentId == 'default'
        && data.keys().hasAll([
          'schemaVersion', 'id', 'userId', 'timezone', 'locale', 'quietHours',
          'desktopEnabled', 'whatsappEnabled', 'emailEnabled',
          'reminderOffsetsMinutes', 'atStartEnabled', 'missedStart',
          'maxRemindersPerBlock', 'dailyReport', 'weeklyReport',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'id', 'userId', 'timezone', 'locale', 'quietHours',
          'desktopEnabled', 'whatsappEnabled', 'emailEnabled',
          'reminderOffsetsMinutes', 'atStartEnabled', 'missedStart',
          'maxRemindersPerBlock', 'dailyReport', 'weeklyReport',
          'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 'notification-preferences-v1'
        && data.id == documentId
        && data.userId == uid
        && data.timezone is string
        && data.timezone.size() >= 1
        && data.timezone.size() <= 100
        && data.locale is string
        && data.locale.size() >= 2
        && data.locale.size() <= 35
        && data.quietHours is map
        && data.quietHours.keys().hasAll(['enabled', 'start', 'end'])
        && data.quietHours.keys().hasOnly(['enabled', 'start', 'end'])
        && data.quietHours.enabled is bool
        && validClock(data.quietHours.start)
        && validClock(data.quietHours.end)
        && data.desktopEnabled is bool
        && data.whatsappEnabled is bool
        && data.emailEnabled is bool
        && validReminderOffsets(data.reminderOffsetsMinutes)
        && data.atStartEnabled is bool
        && data.missedStart is map
        && data.missedStart.keys().hasAll(['enabled', 'afterMinutes'])
        && data.missedStart.keys().hasOnly(['enabled', 'afterMinutes'])
        && data.missedStart.enabled is bool
        && data.missedStart.afterMinutes is int
        && data.missedStart.afterMinutes >= 1
        && data.missedStart.afterMinutes <= 240
        && data.maxRemindersPerBlock is int
        && data.maxRemindersPerBlock >= 1
        && data.maxRemindersPerBlock <= 8
        && data.dailyReport is map
        && data.dailyReport.keys().hasAll(['enabled', 'localTime'])
        && data.dailyReport.keys().hasOnly(['enabled', 'localTime'])
        && data.dailyReport.enabled is bool
        && validClock(data.dailyReport.localTime)
        && data.weeklyReport is map
        && data.weeklyReport.keys().hasAll(['enabled', 'isoWeekday', 'localTime'])
        && data.weeklyReport.keys().hasOnly(['enabled', 'isoWeekday', 'localTime'])
        && data.weeklyReport.enabled is bool
        && data.weeklyReport.isoWeekday is int
        && data.weeklyReport.isoWeekday >= 1
        && data.weeklyReport.isoWeekday <= 7
        && validClock(data.weeklyReport.localTime)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isClientCollection(collectionName) {
      return collectionName in [
        'domains',
        'goals',
        'keyResults',
        'projects',
        'tasks',
        'timeBlocks',
        'sessions',
        'habits',
        'habitLogs',
        'metrics',
        'calendarEvents',
        'deadlines',
        'journalEntries',
        'insights',
        'achievements',
        'notes',
        'noteTemplates',
        'goalRoadmaps',
        'visionBoards',
        'visionItems',
        'mediaAssets',
        'pages'
      ];
    }

    // Root user documents are server-managed. Client data lives only in an
    // allowlisted collection below the authenticated user's path.
    match /users/{uid} {
      allow read, write: if false;

      match /{collectionName}/{documentId} {
        allow get: if isClientCollection(collectionName)
          && ownsPath(uid)
          && existingOwnershipMatchesPath(uid);

        // Firestore list rules are query constraints, not row filters. Require
        // the client query to constrain the embedded owner as well as the
        // owner-scoped path so a corrupt/misplaced document cannot leak from a
        // collection read.
        allow list: if isClientCollection(collectionName)
          && ownsPath(uid)
          && resource.data.userId == uid;

        allow create: if isClientCollection(collectionName)
          && ownsPath(uid)
          && hasValidCreateOwnership(uid, documentId)
          && hasValidTimeBlockFields(collectionName)
          && hasValidCriticalNumbers();

        allow update: if isClientCollection(collectionName)
          && ownsPath(uid)
          && existingOwnershipMatchesPath(uid)
          && keepsProtectedFieldsImmutable()
          && hasValidTimeBlockFields(collectionName)
          && hasValidCriticalNumbers();

        allow delete: if isClientCollection(collectionName)
          && ownsPath(uid)
          && existingOwnershipMatchesPath(uid);
      }

      // The login streak has exactly one document per user. Keeping it out of
      // the generic allowlist prevents a client from minting extra streak docs.
      match /login_streaks/{documentId} {
        allow get: if ownsPath(uid)
          && documentId == uid
          && existingOwnershipMatchesPath(uid);

        allow create: if ownsPath(uid)
          && documentId == uid
          && hasValidCreateOwnership(uid, documentId)
          && hasValidCriticalNumbers();

        allow update: if ownsPath(uid)
          && documentId == uid
          && existingOwnershipMatchesPath(uid)
          && keepsProtectedFieldsImmutable()
          && hasValidCriticalNumbers();

        allow delete: if ownsPath(uid)
          && documentId == uid
          && existingOwnershipMatchesPath(uid);
      }

      // Users control only validated channel and schedule preferences. Jobs,
      // provider state, delivery receipts, and idempotency stay server-owned.
      match /notificationPreferences/{documentId} {
        allow get: if ownsPath(uid)
          && documentId == 'default'
          && resource.data.userId == uid;

        allow list: if ownsPath(uid)
          && resource.data.userId == uid;

        allow create: if ownsPath(uid)
          && hasValidNotificationPreferences(uid, documentId);

        allow update: if ownsPath(uid)
          && resource.data.userId == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['schemaVersion', 'id', 'userId', 'createdAt'])
          && hasValidNotificationPreferences(uid, documentId);

        allow delete: if ownsPath(uid)
          && documentId == 'default'
          && resource.data.userId == uid;
      }

      // Generated scientific reports are immutable client-side. Owners may
      // read their own artifacts and query history only when the embedded
      // owner is constrained, preventing a corrupt/misplaced document leak.
      match /reportArchives/{documentId} {
        allow get: if ownsPath(uid)
          && resource.data.userId == uid
          && resource.data.id == documentId;

        allow list: if ownsPath(uid)
          && resource.data.userId == uid;

        allow create, update, delete: if false;
      }

      // Defense in depth: these resources are written only by the backend via
      // the Admin SDK, which bypasses Firestore Security Rules.
      match /aiChangePlans/{document=**} {
        allow read, write: if false;
      }
      match /aiSnapshots/{document=**} {
        allow read, write: if false;
      }
      match /aiApprovals/{document=**} {
        allow read, write: if false;
      }
      match /aiExecutions/{document=**} {
        allow read, write: if false;
      }
      match /aiAuditLogs/{document=**} {
        allow read, write: if false;
      }
      match /aiIdempotency/{document=**} {
        allow read, write: if false;
      }
      match /aiRateLimits/{document=**} {
        allow read, write: if false;
      }
      match /reminderJobs/{document=**} {
        allow read, write: if false;
      }
      match /reminderManifests/{document=**} {
        allow read, write: if false;
      }
      match /deliveryAttempts/{document=**} {
        allow read, write: if false;
      }
      match /deliveryReceipts/{document=**} {
        allow read, write: if false;
      }
      match /notificationIdempotency/{document=**} {
        allow read, write: if false;
      }
      match /reminderDeliveryCounters/{document=**} {
        allow read, write: if false;
      }
      match /providerDeliveryStatuses/{document=**} {
        allow read, write: if false;
      }
      match /reportIdempotency/{document=**} {
        allow read, write: if false;
      }
      match /reportDeliveryAttempts/{document=**} {
        allow read, write: if false;
      }
    }

    match /aiChangePlans/{document=**} {
      allow read, write: if false;
    }
    match /aiSnapshots/{document=**} {
      allow read, write: if false;
    }
    match /aiApprovals/{document=**} {
      allow read, write: if false;
    }
    match /aiExecutions/{document=**} {
      allow read, write: if false;
    }
    match /aiAuditLogs/{document=**} {
      allow read, write: if false;
    }
    match /aiIdempotency/{document=**} {
      allow read, write: if false;
    }
    match /aiRateLimits/{document=**} {
      allow read, write: if false;
    }
    match /reminderProviderCallbackRoutes/{document=**} {
      allow read, write: if false;
    }
    match /reminderApiRateLimits/{document=**} {
      allow read, write: if false;
    }
    match /reportArchives/{document=**} {
      allow read, write: if false;
    }
    match /reportIdempotency/{document=**} {
      allow read, write: if false;
    }
    match /reportDeliveryAttempts/{document=**} {
      allow read, write: if false;
    }

    // Deny by default, including unknown top-level collections, unknown user
    // subcollections, and any nested documents not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
