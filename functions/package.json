{
  "name": "life-tracker-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:release && npm run typecheck:check && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=lib/index.js --sourcemap",
    "build:shared": "esbuild build/shared-validators-entry.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=.generated/shared-validators.cjs --sourcemap",
    "build:release": "node build/release-id.mjs",
    "pretest": "npm run build:shared && npm run build:release",
    "pretest:run": "npm run build:shared && npm run build:release",
    "typecheck": "npm run build:shared && npm run build:release && npm run typecheck:check",
    "typecheck:check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-email/render": "2.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "openai": "^6.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.1",
    "sharp": "0.35.3",
    "twilio": "6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.2.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
